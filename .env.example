# Tonezen backend environment — copy to .env and adjust for production
# Internal Docker service URLs (db, storage, kong, …) are hardcoded in docker-compose.yml

# Postgres
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_DB=tonezen

# Supabase Auth (GoTrue)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
API_EXTERNAL_URL=http://localhost:8000
GOTRUE_SITE_URL=http://localhost:8000
GOTRUE_URI_ALLOW_LIST=
GOTRUE_DISABLE_SIGNUP=false

# Supabase Realtime + Studio
SECRET_KEY_BASE=your-super-secret-realtime-key-base-min-64-chars-long-change-me
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min
SUPABASE_PUBLIC_URL=http://localhost:8000
STUDIO_DEFAULT_ORGANIZATION=Tonezen
STUDIO_DEFAULT_PROJECT=Tonezen

# Client apps (desktop dev / build)
TONEZEN_API_URL=http://localhost:8000/api/v1
TONEZEN_SUPABASE_URL=http://localhost:8000
TONEZEN_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Indexer (scans storage file backend after Studio upload)
INDEXER_INTERVAL_SECONDS=60

# Host ports
KONG_HTTP_PORT=8000
