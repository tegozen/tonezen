# Tonezen — run: node scripts/gen-env.mjs
# Internal Docker service URLs (db, storage, kong, …) are hardcoded in docker-compose.yml

# Beget S3 (shared bucket for dev and prod — from Beget panel → Object storage → Access keys)
S3_BUCKET=
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_REGION=ru1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Kong (port + public URL — keep in sync)
KONG_HTTP_PORT=8000
TONEZEN_BASE_URL=http://localhost:8000

# Postgres (required — generated by scripts/gen-env.mjs; db not exposed on host)
POSTGRES_DB=tonezen
POSTGRES_PASSWORD=

# Supabase Auth (GoTrue) — generated by scripts/gen-env.mjs
JWT_SECRET=
# Optional API JWT checks (omit unless tokens include matching aud/iss claims)
# JWT_AUD=authenticated
# JWT_ISS=
ANON_KEY=
SERVICE_ROLE_KEY=
GOTRUE_URI_ALLOW_LIST=
GOTRUE_SMTP_ADMIN_EMAIL=admin@tonezen.local
GOTRUE_SMTP_HOST=mail
GOTRUE_SMTP_PORT=2500
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_SENDER_NAME=Tonezen

# Studio dashboard (HTTP basic auth via Kong — not GoTrue login)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Default app admin (GoTrue + GlitchTip UI login)
ADMIN_EMAIL=admin@tonezen.local
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=

# Supabase Realtime + Studio — generated by scripts/gen-env.mjs
# DB_ENC_KEY must be exactly 16 characters (Realtime AES-128). Example: openssl rand -hex 8
SECRET_KEY_BASE=
PG_META_CRYPTO_KEY=
DB_ENC_KEY=
STUDIO_NAME=Tonezen

# GlitchTip secrets (project ids 1=android / 2=desktop are hardcoded in clients + seed)
# DSN: https://<PUBLIC_KEY>@<host>/glitchtip/<project_id>
GLITCHTIP_SECRET_KEY=
GLITCHTIP_POSTGRES_PASSWORD=
GLITCHTIP_ANDROID_PUBLIC_KEY=
GLITCHTIP_DESKTOP_PUBLIC_KEY=
GLITCHTIP_AUTH_TOKEN=
