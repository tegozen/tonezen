{
  "name": "@tonezen/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Tonezen desktop — offline-first media player",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "node scripts/prepare-client-env.mjs && npm run build && electron-builder --win nsis",
    "dist:mac": "node scripts/prepare-client-env.mjs && npm run build && electron-builder --mac dmg",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron.vite.config.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.tonezen.desktop",
    "productName": "Tonezen",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraFiles": [
      {
        "from": "client.env",
        "to": ".env"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "tonezen-macos.${ext}",
      "icon": "resources/app-icon.icns",
      "identity": null,
      "notarize": false
    },
    "dmg": {
      "artifactName": "tonezen-macos.${ext}",
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "tonezen-windows.${ext}",
      "icon": "resources/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tonezen",
      "installerIcon": "resources/app-icon.ico",
      "uninstallerIcon": "resources/app-icon.ico"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.62.2",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
