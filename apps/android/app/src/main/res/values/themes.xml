<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tonezen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/tonezen_bg_app</item>
        <item name="android:statusBarColor">@color/tonezen_bg_app</item>
        <item name="android:navigationBarColor">@color/tonezen_bg_app</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/tonezen_accent_primary</item>
    </style>

    <style name="Theme.Tonezen.Splash" parent="Theme.Tonezen">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>
