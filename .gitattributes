# Cross-platform line endings: LF in git, LF on checkout (Windows + macOS).
# See README.md — one-time: git config core.autocrlf false

* text=auto eol=lf

# Linux/Docker entrypoints — CRLF breaks shebang and shell scripts
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Config & source
*.{yml,yaml,sql,json,md,mjs,cjs,js,ts,tsx,css,html,xml,properties,gradle,kts,kt,mdc} text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
Makefile text eol=lf

# Windows-only launchers (optional CRLF)
*.{bat,cmd,ps1} text eol=crlf

# Binaries
*.{png,jpg,jpeg,gif,webp,ico,svg,pdf,zip,gz,mp3,mp4,wav,apk,aab,jks,keystore,woff,woff2,ttf,eot} binary
